# Copy to .env.local (git-ignored) for local dev — must be KEY=value on each
# line (no bare values), or Vite/Node silently won't set anything.
#
# This is a Vite app, not Next.js, so browser-exposed vars use the VITE_
# prefix (import.meta.env.VITE_...) instead of NEXT_PUBLIC_*.

# Supabase project URL — Project Settings → API. Used both by the browser
# (read-only queries) and by api/webhooks/stripe.js.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase anon/public key — same page. Safe to expose to the browser.
VITE_SUPABASE_ANON_KEY=eyJ...

# Supabase service_role key (server-only, bypasses RLS) — same page,
# "service_role" secret. Used only by api/webhooks/stripe.js — the one
# place a paid booking gets written. Never expose this one to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe secret key (server-only) — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (server-only) — created when you register
# the /api/webhooks/stripe endpoint (Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
