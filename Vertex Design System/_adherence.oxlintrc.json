{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/patterns/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Italiana|Orbitron|IBM Plex Sans|IBM Plex Mono|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Italiana, Orbitron, IBM Plex Sans, IBM Plex Mono, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcousticTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|duration|src|key|ref|className|style|children)$/]",
        "message": "<AcousticTrack> doesn't accept that prop. Declared props: label, duration, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|rare|dark|paper)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'rare' | 'dark' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeforeAfter'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|after|beforeLabel|afterLabel|ratio|style|key|ref|className|style|children)$/]",
        "message": "<BeforeAfter> doesn't accept that prop. Declared props: before, after, beforeLabel, afterLabel, ratio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlueprintRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|tone|tick|animate|length|style|key|ref|className|style|children)$/]",
        "message": "<BlueprintRule> doesn't accept that prop. Declared props: orientation, tone, tick, animate, length, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlueprintRule'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<BlueprintRule> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlueprintRule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:structural|faint|gold)$/]",
        "message": "<BlueprintRule> tone must be one of 'structural' | 'faint' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuildCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|title|donor|status|hours|power|image|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<BuildCard> doesn't accept that prop. Declared props: code, title, donor, status, hours, power, image, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BuildCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:available|rare|sold|building)$/]",
        "message": "<BuildCard> status must be one of 'available' | 'rare' | 'sold' | 'building'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|href|iconLeft|iconRight|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, href, iconLeft, iconRight, fullWidth, onClick, style."
